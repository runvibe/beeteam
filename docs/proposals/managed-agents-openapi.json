    "/api/v2/agent-conversations": {
      "get": {
        "operationId": "listAgentSessions",
        "x-contract-status": "proposed",
        "description": "Team leader sessions across agents. Filters accept comma-separated UUIDv7 lists (at most 50 each); boardId also accepts `none` for sessions without a board.",
        "parameters": [
          {
            "name": "teamId",
            "in": "query",
            "description": "Comma-separated team IDs.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          {
            "name": "agentId",
            "in": "query",
            "description": "Comma-separated leader agent IDs.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          {
            "name": "boardId",
            "in": "query",
            "description": "Comma-separated board IDs or `none`.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "enum": [
                "updated_desc",
                "updated_asc"
              ],
              "default": "updated_desc"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful contract response. This proposal is not an active runtime endpoint.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationPage"
