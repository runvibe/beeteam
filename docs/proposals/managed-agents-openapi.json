  "components": {
    "schemas": {
      "ToolProfile": {
        "type": "object",
        "properties": {
          "webSearch": {
            "enum": [
              "live",
              "cached",
              "disabled"
            ]
          },
          "networkAccess": {
            "type": "boolean"
          },
          "enabledMcpServers": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          },
          "skillRoots": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "x-maxBytes": 4096,
              "x-absolutePath": true
            }
          }
        },
        "required": [
          "webSearch",
          "networkAccess",
          "enabledMcpServers",
          "skillRoots"
        ],
        "additionalProperties": false
      },
      "ExecutionConfiguration": {
        "type": "object",
