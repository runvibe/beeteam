      <mxGeometry as="geometry" x="670" y="570" width="240" height="100" />
    </mxCell>
    <mxCell id="has" value="Time existente:&lt;br&gt;tem líder?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#0f172a;fontFamily=Arial;fontSize=21;spacing=14;" vertex="1" parent="1">
      <mxGeometry as="geometry" x="315" y="710" width="280" height="120" />
    </mxCell>
    <mxCell id="one" value="&lt;b&gt;CASO 1 · COM LÍDER&lt;/b&gt;&lt;br&gt;Consultar time e agente líder&lt;br&gt;Assumir perfil, instruções,&lt;br&gt;estilo, regras e contexto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#64748b;fontColor=#0f172a;fontFamily=Arial;fontSize=21;spacing=14;" vertex="1" parent="1">
      <mxGeometry as="geometry" x="40" y="890" width="380" height="140" />
    </mxCell>
    <mxCell id="two" value="&lt;b&gt;CASO 2 · SEM LÍDER&lt;/b&gt;&lt;br&gt;Ler time · criar e vincular&lt;br&gt;liderança adequada&lt;br&gt;Assumir o perfil criado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#64748b;fontColor=#0f172a;fontFamily=Arial;fontSize=21;spacing=14;" vertex="1" parent="1">
