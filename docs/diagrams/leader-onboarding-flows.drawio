    <mxCell id="title" value="&lt;b&gt;Bee Team Leader · três fluxos de entrada&lt;/b&gt;" style="text;strokeColor=none;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#0f172a;fontFamily=Arial;fontSize=32;spacing=14;" vertex="1" parent="1">
