    </mxCell>
    <mxCell id="read" value="&lt;b&gt;Contextualizar o time&lt;/b&gt;&lt;br&gt;Descrição · colaboradores · boards geridos&lt;br&gt;Tarefas relacionadas · histórico · progresso&lt;br&gt;Pendências e bloqueios" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontFamily=Arial;fontSize=21;spacing=14;" vertex="1" parent="1">
      <mxGeometry as="geometry" x="235" y="1090" width="440" height="145" />
    </mxCell>
    <mxCell id="state" value="&lt;b&gt;Situação reconstruída&lt;/b&gt;&lt;br&gt;Concluído · em andamento · interrompido&lt;br&gt;Sem duplicar líder existente ou sobrescrever perfil" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontFamily=Arial;fontSize=20;spacing=14;" vertex="1" parent="1">
      <mxGeometry as="geometry" x="235" y="1290" width="440" height="110" />
    </mxCell>
    <mxCell id="structure" value="&lt;b&gt;Se faltar estrutura&lt;/b&gt;&lt;br&gt;Conversar sobre projeto e propor próximos passos:&lt;br&gt;board, tarefas e colaboradores.&lt;br&gt;Transferir gestão só quando autorizado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontFamily=Arial;fontSize=20;spacing=14;" vertex="1" parent="1">
      <mxGeometry as="geometry" x="100" y="1450" width="710" height="120" />
    </mxCell>
    <mxCell id="new" value="&lt;b&gt;CASO 3 · NOVO TIME&lt;/b&gt;&lt;br&gt;Entender projeto antes de definir pessoas&lt;br&gt;Objetivo · história · atuação · entregas&lt;br&gt;Uma pergunta por vez; skills de apoio disponíveis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#64748b;fontColor=#0f172a;fontFamily=Arial;fontSize=21;spacing=14;" vertex="1" parent="1">
      <mxGeometry as="geometry" x="1040" y="710" width="500" height="140" />
    </mxCell>
    <mxCell id="proposal" value="&lt;b&gt;Propor squad multidisciplinar e personas&lt;/b&gt;&lt;br&gt;Inclui líder: nome, avatar desejado, descrição,&lt;br&gt;especialidade, responsabilidades,&lt;br&gt;instruções, estilo e regras" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#64748b;fontColor=#0f172a;fontFamily=Arial;fontSize=21;spacing=14;" vertex="1" parent="1">
      <mxGeometry as="geometry" x="1040" y="900" width="500" height="140" />
    </mxCell>
    <mxCell id="review" value="Usuário revisa&lt;br&gt;e aprova?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#0f172a;fontFamily=Arial;fontSize=21;spacing=14;" vertex="1" parent="1">
      <mxGeometry as="geometry" x="1150" y="1090" width="280" height="120" />
    </mxCell>
    <mxCell id="register" value="&lt;b&gt;Após aprovação concreta&lt;/b&gt;&lt;br&gt;Cadastrar agentes, time e vínculos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#64748b;fontColor=#0f172a;fontFamily=Arial;fontSize=21;spacing=14;" vertex="1" parent="1">
      <mxGeometry as="geometry" x="1040" y="1280" width="500" height="90" />
