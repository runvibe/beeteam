    <mxCell id="chats" value="Criar chats separados autorizados&lt;br&gt;Handoff com perfil/contexto&lt;br&gt;Persistir referências reais dos chats" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#64748b;fontColor=#0f172a;fontFamily=Arial;fontSize=21;spacing=14;" vertex="1" parent="1">
