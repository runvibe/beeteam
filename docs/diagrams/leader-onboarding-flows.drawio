    </mxCell>
    <mxCell id="future" value="&lt;b&gt;Pronto para continuidade de gestão&lt;/b&gt;&lt;br&gt;Política de próxima tarefa, retomada e gestão contínua: A DETALHAR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#64748b;fontColor=#0f172a;fontFamily=Arial;fontSize=23;spacing=14;" vertex="1" parent="1">
      <mxGeometry as="geometry" x="410" y="1660" width="760" height="100" />
    </mxCell>
    <mxCell id="notes" value="&lt;b&gt;LIMITES&lt;/b&gt; · Squad com competências completas ≠ execução automática. Preservar modos board/task.&lt;br&gt;Projeto é a demanda, não entidade Project/workspace. Escolha na UI não chega automaticamente ao chat.&lt;br&gt;&lt;b&gt;MCP&lt;/b&gt;: registros, skills e prompts. &lt;b&gt;Harness&lt;/b&gt;: ferramentas para abrir painel e criar chats, conforme capacidade/autorização.&lt;br&gt;Avatar e mecanismos de geração: a detalhar. Sem ferramentas disponíveis, declarar a etapa pendente." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;fontFamily=Arial;fontSize=20;spacing=14;" vertex="1" parent="1">
      <mxGeometry as="geometry" x="30" y="1810" width="1550" height="150" />
    </mxCell>
