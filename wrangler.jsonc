{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beeteam",
  "account_id": "a5e73541f4632f1a1700b1b250a99363",
  "main": "deploy/app/worker.mjs",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "preview_urls": true,
  "previews": {},
  "routes": [
    {
      "pattern": "getbee.team/app",
      "zone_name": "getbee.team"
    },
    {
      "pattern": "getbee.team/app/*",
      "zone_name": "getbee.team"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./.local/cloudflare/app",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none",
    "html_handling": "none"
  }
}
