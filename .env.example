# Optional application database override; existing .env values remain authoritative
# DATABASE_URL=postgres://postgres:postgres@localhost:5453/postgres
# BEE_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5453/beeteam_test
# Application settings
APP_HOST=127.0.0.1
APP_PORT=59865
# MCP (Model Control Plane) settings
MCP_ENABLED=true
MCP_PATH=/mcp
# OpenTelemetry (OTLP)
OTEL_ENABLED=false
COLLECTOR_OTLP_ENABLED=false
OTEL_SERVICE_NAME=beeteam
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=always_on
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_RESOURCE_ATTRIBUTES=service.version=0.1.0,deployment.environment=local
# Default: SQLite at ~/.beeteam/beeteam.sql; omit DATABASE_URL to use it.
# For PostgreSQL, explicitly set DATABASE_DRIVER=postgres and DATABASE_URL.
# DATABASE_DRIVER=sqlite
# DATABASE_URL=sqlite://C:/bee-data/beeteam.sqlite

# Distribution embeds the UI; explicitly opt out for API-only runtime:
# BEE_FRONTEND_MODE=disabled
